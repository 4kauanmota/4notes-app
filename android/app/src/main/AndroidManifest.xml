<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      requestLegacyExternalStorage: no Android 10, o acesso às pastas do armazenamento
      interno funciona como nas versões anteriores (o workspace numa pasta escolhida por você).
    -->
    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:requestLegacyExternalStorage="true"
        android:theme="@style/AppTheme">

        <!--
          configChanges: abrir/fechar o celular dobrável, girar a tela ou mudar o tamanho
          da janela NÃO recria a tela — a interface só se reorganiza (sem perder nada).
        -->
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:resizeableActivity="true"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissões -->

    <!-- Título e ícone dos sites salvos no módulo Links -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Vibração curta ao abrir um menu com o toque prolongado -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!--
      O workspace fica numa pasta escolhida por você (que o Google Drive, o Autosync ou o
      FolderSync podem sincronizar): no Android 11+ isso exige o "Acesso a todos os arquivos".
    -->
    <uses-permission
        android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />
    <!-- Android 10 ou anterior -->
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="29"
        tools:ignore="ScopedStorage" />
</manifest>
