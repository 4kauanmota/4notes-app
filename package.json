{
  "name": "4notes",
  "productName": "4notes",
  "version": "1.6.3",
  "version": "1.6.3",
  "description": "Aplicativo pessoal de notas, tarefas, mapa mental, links e timer — 100% local, no computador (Windows) e no celular (Android).",
  "author": "Kauan",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "main": "dist-electron/main.cjs",
  "updates": {
    "github": ""
  },
  "updates": {
    "github": ""
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "nuxt generate && node scripts/build-electron.mjs",
    "build:web": "nuxt generate",
    "build:windows": "npm run dist:win",
    "build:android": "node scripts/android.mjs build",
    "build:ios": "node scripts/ios.mjs",
    "android:sync": "node scripts/android.mjs sync",
    "android:open": "node scripts/android.mjs open",
    "android:run": "node scripts/android.mjs run",
    "start": "npm run build && electron .",
    "dist": "npm run build && electron-builder",
    "dist:win": "npm run build && electron-builder --win",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:linux": "npm run build && electron-builder --linux",
    "release": "node scripts/release.mjs",
    "release": "node scripts/release.mjs",
    "test": "vitest run",
    "typecheck": "nuxt typecheck && tsc -p electron --noEmit",
    "postinstall": "nuxt prepare"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.1.2",
    "@capacitor/cli": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "@capacitor/filesystem": "^8.1.4",
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "@lezer/highlight": "^1.2.5",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "electron-updater": "^6.8.9",
    "electron-updater": "^6.8.9",
    "esbuild": "^0.28.2",
    "nuxt": "^4.5.2",
    "typescript": "~6.0.3",
    "vitest": "^5.0.3",
    "vue": "^3.5.43",
    "vue-router": "^5.3.1",
    "vue-tsc": "^3.3.11"
  },
  "updates": {
    "github": "4kauanmota/4notes-app"
  }
}
