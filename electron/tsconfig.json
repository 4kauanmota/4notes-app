{
  // Usado apenas para checagem de tipos (`npm run typecheck`).
  // A compilação de verdade é feita pelo esbuild em scripts/build-electron.mjs.
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM"],
    "types": ["node"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true
  },
  "include": ["./**/*.ts", "../shared/**/*.ts"]
}
